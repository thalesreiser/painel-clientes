---
import Base from '../layouts/Base.astro';
import { carregarCliente } from '../lib/cliente.ts';

// Placeholder page: the real dashboards come in WEB-02.x.
const cliente = carregarCliente();
---

<Base>
  <h1 class="text-2xl font-semibold">{cliente.nome}</h1>
  <p class="mt-2">Template: {cliente.template}</p>
  <h2 class="mt-6 text-lg font-semibold">KPIs ativos</h2>
  <ul class="mt-2 list-disc pl-6">
    {cliente.kpis_ativos.map((kpi) => <li>{kpi}</li>)}
  </ul>
</Base>
